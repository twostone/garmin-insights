{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>twostone/hassio-workflows"
  ],
  "packageRules": [
    {
      "description": "svelte-check unterstützt TypeScript 7 noch nicht (siehe AGENTS.md)",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "MCP-SDK v2 ist exakt gepinnt (siehe AGENTS.md): Updates einzeln und bewusst",
      "matchPackageNames": [
        "@modelcontextprotocol/server",
        "@modelcontextprotocol/client"
      ],
      "groupName": "MCP-SDK",
      "rangeStrategy": "pin"
    },
    {
      "description": "SvelteKit 3 braucht @vite-pwa/sveltekit mit Kit-3-Support (heute nur Kit 2) und adapter-static 4",
      "matchPackageNames": [
        "@sveltejs/kit",
        "@sveltejs/adapter-static"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
